# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Sem essas variáveis, o app funciona só no modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lembretes diários (opcional). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protege a rota /api/lembretes chamada pelo agendador da Vercel.
# O mesmo valor fica no banco (privado.config, chave cron_secret).
CRON_SECRET=
