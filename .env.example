# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Sem essas variáveis, o app funciona só no modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lembretes diários (opcional). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Chave de serviço do Supabase, usada só no servidor pelo envio dos lembretes
SUPABASE_SERVICE_ROLE_KEY=
# Protege a rota /api/lembretes chamada pelo agendador da Vercel
CRON_SECRET=
